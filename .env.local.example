# Firebase Client SDK Configuration
# Get these values from Firebase Console: https://console.firebase.google.com/u/0/project/brevin-kokarmina/settings/general
# Click on "Add app" or select your web app, then copy the config values

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=brevin-kokarmina.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=brevin-kokarmina
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=brevin-kokarmina.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here

# Firebase Admin SDK Configuration
# Get this from Firebase Console: https://console.firebase.google.com/u/0/project/brevin-kokarmina/settings/serviceaccounts/adminsdk
# Click "Generate new private key" and download the JSON file
# Copy the entire JSON content and paste it here as a single line (or use the individual fields below)

FIREBASE_ADMIN_PROJECT_ID=brevin-kokarmina
FIREBASE_ADMIN_CLIENT_EMAIL=your_service_account_email@brevin-kokarmina.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# Alternative: Use the entire service account JSON (base64 encoded)
# FIREBASE_SERVICE_ACCOUNT_KEY=base64_encoded_json_here
